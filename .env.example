# Cadieux website — environment variables
#
# Copy to .env.local for development; configure in Vercel for production.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site URL (used in emails and absolute links)
NEXT_PUBLIC_SITE_URL=https://www.cadieux.in

# Google Maps (public, restricted to Cadieux domains in GCP console)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Twilio Verify (OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# OTP signing
OTP_SECRET=

# Cloudflare Turnstile (anti-bot)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis (rate-limit)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Mobile app shared key (X-Cadieux-Mobile-Key)
MOBILE_APP_KEY=

# Admin dashboard bearer
ADMIN_TOKEN=

# Cron auth — generate with: openssl rand -hex 32
CRON_SECRET=

# Resend (subscription expiry reminder emails)
RESEND_API_KEY=
# Optional: override default sender. Must be a verified Resend domain.
# RESEND_FROM_EMAIL=Cadieux <hello@cadieux.in>
